<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): without QUERY_ALL_PACKAGES the
         system filters package queries to "visible" packages only, so the
         installed-app list the agent reads is silently incomplete — the user
         asks "which apps do I have" and gets a partial answer. This app is a
         sideloaded personal tool (never published to Play), so the policy
         concern that blocks Play does not apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- WebView reads the content:// URIs returned by the system image
         picker (ACTION_GET_CONTENT) before injecting them as File objects
         into the page's <input type="file">. On Android 13+ scoped storage
         requires READ_MEDIA_IMAGES; older versions gate on READ_EXTERNAL_STORAGE.
         Intent.FLAG_GRANT_READ_URI_PERMISSION alone is not enough on some
         OEM ROMs — the WebView process still needs the underlying media
         permission or FileReader.readAsDataURL silently fails and the
         attachment never lands in the chat input. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- CameraX + ML Kit Barcode Scanning power the QR entry point. CAMERA
         is requested at runtime when the user opens ScanQrScreen; if denied
         we bounce back to Home with a Snackbar hint. hardware.camera is
         declared as required="false" so the app stays installable on
         tablets/emulators without a back camera (Google Play filter rule). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Foreground service keeps the WebView's network stack (SSE / long-poll
         / WebSocket) alive while the user is in another app or the screen is
         off — without this, Android freezes WebView networking as soon as
         Activity.onPause fires and the user's running session drops. dataSync
         is the right type for "hold open a network sync session"; the matching
         FOREGROUND_SERVICE_DATA_SYNC permission is mandatory on Android 14
         (API 34) or startForeground throws SecurityException. WAKE_LOCK is
         required on Android 13+ to acquire PARTIAL_WAKE_LOCK from the
         service. POST_NOTIFICATIONS (API 33+) gates the ongoing status
         notification; we don't request it at runtime yet — the service still
         runs, the notification just gets silently dropped by the OS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 本地引擎的前台服务用 specialUse 类型:它不是数据同步,也不是媒体播放,
         就是「用户可见的常驻 agent 引擎」。Android 14 上 specialUse 必须同时
         声明权限和下面的 PROPERTY_SPECIAL_USE_FGS_SUBTYPE,否则 startForeground
         直接抛 SecurityException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 截屏服务是 type=mediaProjection 的前台服务,Android 14 上必须声明
         这个权限,否则 startForeground 抛 SecurityException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 会话详情页输入条的语音转文字（ui/VoiceInput.kt）。
         用平台 SpeechRecognizer，语音识别由系统「语音服务」提供（Google /
         厂商 ROM 自带），App 侧不需要绑任何第三方 SDK；代价是必须联网 +
         设备上得真的装了识别服务，所以 UI 要先 isRecognitionAvailable() 探测。
         Android 6+ 是危险权限，运行时申请（VoiceInputEffect 里发）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 「修改系统设置」:本机 agent 要能改亮度 / 息屏时间 / 飞行模式 / 音量。
         这是 **特殊权限**(appop),不是危险权限 —— 声明只是拿到资格,真正
         生效还得用户去「设置 → 应用 → 特殊应用权限 → 修改系统设置」里开,
         代码代劳不了。设置页有入口(跳 ACTION_MANAGE_WRITE_SETTINGS)。

         ⚠️ 不声明这一条的后果很隐蔽:Settings.System.canWrite() 恒为 false,
         于是「写系统设置」这一整组能力只报一句「没权限」,而**读**是好的 ——
         看起来像「这个功能不支持写」,实际是 manifest 少了一行。 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- SpeechRecognizer.createSpeechRecognizer() / isRecognitionAvailable()
         内部走 PackageManager.queryIntentServices 找 SpeechService。targetSdk
         30+ 的包可见性过滤会把没声明的服务直接藏掉 —— 漏掉这段会在真机上
         稳定拿到 isRecognitionAvailable()==false，表现是「语音按钮点了没反应」，
         而且不报任何错。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".LanAgentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LanAgent">

        <!-- android:screenOrientation="portrait" locks the Activity to
             portrait. WebView is a child view of this Activity, so the
             zai /m page (which doesn't ship a landscape layout) also
             stays portrait. "behind" / "nosensor" were considered: "behind"
             would inherit the launcher's orientation (LAUNCHER itself is
             portrait on phones, so functionally the same, but couples us
             to the home screen's orientation setting); "nosensor" would
             freeze at whatever the device happened to be when the app
             started, which on a tablet launched while held sideways
             could be wrong. "portrait" is explicit and matches the
             chat/agent UI we wrap. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LanAgent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AA OAuth(PKCE)的回调地址。scheme/host/path 与 AA 官方 Android 端
                 逐项一致 —— 官方 MainActivity 就有这一条,本项目原先没有。
                 此前登录回调全靠登录 WebView 的 shouldOverrideUrlLoading 在进程内
                 拦下,所以缺了也不报错;补上后:① 与官方行为对齐;② 官方云登录若改走
                 系统浏览器(Custom Tabs),回调才有地方可回。
                 配套接线见 MainActivity.onNewIntent 与 AaHostScreen。
                 singleTop 是必需的:没有它,深链会新建一个 MainActivity 实例而不是
                 走 onNewIntent,现有实例里的 WebLoginViewModel 收不到回调。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="agents-anywhere" />
            </intent-filter>
        </activity>

        <!-- Started from WebViewScreen via DisposableEffect(url); stops
             itself when the user navigates back to Home. exported=false —
             it's a private IPC target, only this app's components start it. -->
        <service
            android:name=".service.WebViewKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 本地引擎(feat/local-engine)。**必须跑在独立的 :engine 进程里**:
             node::Start 一个进程只能调一次(V8 全局状态不可重入),引擎崩了
             没法原地重启,只能整个进程换新的 —— 独立进程是这条约束的前提。
             引擎监听 127.0.0.1:9420,主进程用 OkHttp 直连,复用现有的
             AgentApi / SSE 客户端。 -->
        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:process=":engine"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the on-device agent engine (Node runtime embedded in the APK) while the user works with local agent sessions." />
        </service>

        <!-- 能力桥的通知读取服务。Android 上读通知栏只有这一条路:
             NotificationListenerService,得用户在系统设置里给「通知使用权」。
             BIND_NOTIFICATION_LISTENER_SERVICE 是系统专有的权限,不用声明
             uses-permission;exported 必须为 true(系统要绑它)。 -->
        <service
            android:name=".engine.PhoneNotificationListener"
            android:exported="true"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 截屏。Android 14 起 MediaProjection 必须先有 type=mediaProjection
             的前台服务才能 getMediaProjection(),顺序反了直接 SecurityException。
             所以这个服务不是可选的,是截屏的必经之路。 -->
        <service
            android:name=".engine.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 无障碍服务:让本机 agent 能读屏 + 点按 + 输入 + 滑动。
             这是 Android 上唯一合法的「代替用户操作别的 App」的通道 ——
             控件树(不是像素),所以点得准、输入不依赖输入法。
             BIND_ACCESSIBILITY_SERVICE 是系统专有权限,必须 exported=true
             (系统要绑它);用户得在系统设置里手动打开 —— 设置页有入口。 -->
        <service
            android:name=".engine.PhoneAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 截屏授权的「过桥」Activity。MediaProjection 的授权弹窗只能由
             Activity 发起、结果只能从 Activity 的 onActivityResult 拿 ——
             做成透明的 Activity,用户看到的仍然只有系统那个弹窗。 -->
        <activity
            android:name=".ui.ScreenCaptureConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ── Agents-Anywhere 官方客户端(0.24.2 移植)需要的组件 ──
             MainActivity 不并入:它与本项目的 .MainActivity 职责重复(AA 的根是个
             composable,已在 ui/AaHostScreen.kt 挂进「远程」栏)。
             RemoteTerminalForegroundService 随 AA v2.1.0 的远程终端模块一起恢复:
             它在会话详情页开着时保住终端连接 —— manifest 里不声明的话
             startForegroundService 会直接抛 IllegalArgumentException。 -->
        <service
            android:name="io.github.hotmanxp.lanagent.aa.feature.terminal.RemoteTerminalForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 附件相机拍照(AA 会话输入条)与更新 APK 安装都要通过 FileProvider
             暴露 content:// URI;lan-agent 自己的 WebView 上传走的是
             系统选择器 + bridge,不依赖它。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.aa.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/aa_file_paths" />
        </provider>

        <!-- 本机引擎的 FileProvider。share_to_app 能力要把引擎工作区里的
             文件(截图 / 产物)分享给别的 App,必须走 content:// URI ——
             直接给 file:// 会被 FileUriExposedException 拒掉。
             路径只放开 workspace/ 与 cache/。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.engine.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/engine_file_paths" />
        </provider>

        <!-- AA 自更新模块的安装完成回调。注意我们**没有**声明
             REQUEST_INSTALL_PACKAGES(那是要用户单独授权的高危权限,
             lan-agent 只是个局域网工具),所以下载能走、安装会被系统拒绝,
             属于预期降级。 -->
        <receiver
            android:name="io.github.hotmanxp.lanagent.aa.feature.update.AppUpdateInstallReceiver"
            android:exported="false" />

        <!-- debug-only: drive the AA shell.exec channel from `adb shell am
             broadcast` to verify end-to-end without driving the UI. The
             `@debuggable` guard ties enablement to the build flag, so the
             receiver is dead weight in any release-shaped APK. -->
        <receiver
            android:name="io.github.hotmanxp.lanagent.aa.api.ShellDebugReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.hotmanxp.lanagent.aa.SHELL" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
