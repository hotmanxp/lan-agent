<?xml version="1.0" encoding="utf-8"?>
<!--
    LAN Agent is a tool whose sole purpose is opening LAN URLs that, by their
    nature, are cleartext HTTP on private RFC1918 networks. Manifest sets
    `usesCleartextTraffic="true"` so Android does not block cleartext by default.
    This file is kept as a hook for future HTTPS-only enforcement (e.g. when
    serving LAN over Tailscale/HTTPS); today it permits everything.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>